{
  "name": "wingman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wingman: an AI night-out guardian that never needs you to press SOS.",
  "scripts": {
    "dev": "bun src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "test": "bun test",
    "e2e": "bun test tests/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "tunnel": "bash scripts/tunnel.sh",
    "screenshots": "bun scripts/screenshots.ts",
    "dev:watch": "bun --watch src/server/index.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
