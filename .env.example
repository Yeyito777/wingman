# Copy to .env and fill in what you have. Everything is optional:
# with no keys, Wingman runs fully with a deterministic mock AI scorer
# and a simulated SMS/voice notifier.

PORT=3000
# Public base URL used in share links / SMS (auto-detected from the request if unset)
PUBLIC_URL=

# AI check-in scoring. Gemini is preferred (audio goes straight to the model).
GEMINI_API_KEY=
# Optional override; default tries gemini-flash-latest, then gemini-2.5-flash
GEMINI_MODEL=
# Fallback: OpenAI transcription + small text model
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Force a scorer: gemini | openai | mock (default: best available)
SCORER=

# Level-3 escalation via Twilio (SMS + voice). Simulated in the UI if unset.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Also place a voice call to the emergency contact (default: SMS only)
TWILIO_VOICE=false
